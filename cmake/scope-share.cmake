MACRO(STM_SET_LIBNAME)
    GET_FILENAME_COMPONENT(INTERFACE_NAME ${CMAKE_CURRENT_LIST_DIR} NAME)
    SET(LIBRARY_NAME "${INTERFACE_NAME}_Drivers")
    SET(${INTERFACE_NAME}_INC "$<TARGET_PROPERTY:${INTERFACE_NAME},INTERFACE_INCLUDE_DIRECTORIES>" PARENT_SCOPE)
    MESSAGE(STATUS "LIBNAME:${LIBRARY_NAME} INTERFACE:${INTERFACE_NAME} INC: ${INTERFACE_NAME}_INC")
ENDMACRO(STM_SET_LIBNAME)
GET_FILENAME_COMPONENT(PROJECT_ROOT_DIR ${CMAKE_CURRENT_LIST_DIR} DIRECTORY)
SET(DRIVERS_ROOT_DIR "${PROJECT_ROOT_DIR}/Drivers")
