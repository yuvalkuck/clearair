MACRO(STM_SET_LIBNAME)
    GET_FILENAME_COMPONENT(LIBRARY_NAME ${CMAKE_CURRENT_LIST_DIR} NAME)
    SET(INTERFACE_NAME "${LIBRARY_NAME}_Drivers")
    MESSAGE(STATUS "LIBNAME:${LIBRARY_NAME} INTERFACE:${INTERFACE_NAME}")
ENDMACRO(STM_SET_LIBNAME)
GET_FILENAME_COMPONENT(PROJECT_ROOT_DIR ${CMAKE_CURRENT_LIST_DIR} DIRECTORY)
