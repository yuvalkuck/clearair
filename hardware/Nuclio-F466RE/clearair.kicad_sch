	(text "On-board only (no external wire):\nPA2/PA3 USART2 = ST-LINK VCP, PA5 = LD2,\nPC13 = B1, PA13/PA14 = SWD,\nPH0/PH1 = HSE (ST-LINK MCO), PC14/PC15 = LSE.\nPower: JP5 on E5V, external 5V on CN7-6." (exclude_from_sim no) (at 256.54 264.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "370b88d6-6598-56bb-976a-ad19a2bf3b70"))
