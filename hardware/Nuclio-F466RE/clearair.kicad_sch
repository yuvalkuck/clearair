		(property "Datasheet" "https://www.sgxsensortech.com/content/uploads/2014/08/0278_Datasheet-MiCS-4514.pdf" (at 137.16 139.7 90) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "MiCS-4514 dual gas (CO/reducing + NO2/oxidizing) sensor breakout, 5-pin analog style (VCC/GND/RED/NOX/PRE), e.g. ACROBOTIC MiCS4514 breakout. RED/NOX are raw analog sensor outputs (need external pull-down + your own ppm conversion); PRE is the heater control input (PWM from host). This is NOT the DFRobot Gravity I2C variant (SEN0377), which instead exposes VCC/GND/SDA/SCL." (at 137.16 139.7 90) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "ki_keywords" "MICS-4514 MICS4514 CO NO2 gas sensor analog module" (at 137.16 139.7 90) (effects (font (size 1.27 1.27)) (hide yes)))
